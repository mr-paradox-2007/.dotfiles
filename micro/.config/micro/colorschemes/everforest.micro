# Everforest Dark Medium theme for Micro
# OG Color Palette Specifications

# Core UI
color-link default "#d3c6aa,#2d353b"
color-link line-number "#475258,#2d353b"
color-link current-line-number "#9da9a0,#2d353b"
color-link cursor-line ",#343f44"
color-link color-column "#343f44"

# Window Elements
color-link statusline "#2d353b,#a7c080"
color-link tabbar "#2d353b,#83c092"
color-link divider "#475258,#475258"
color-link message "#d3c6aa,#343f44"
color-link error "bold #e67e80"

# Standard Syntax
color-link comment "#859289"
color-link identifier "#7fbbb3"
color-link statement "#e67e80"
color-link preproc "#e67e80"
color-link type "#dbbc7f"
color-link special "#dbbc7f"
color-link constant "#d699b6"
color-link symbol "#7fbbb3"

# Common Language Extensions
color-link string "#a7c080"
color-link character "#a7c080"
color-link number "#d699b6"
color-link boolean "#d699b6"

# Editor UI States
color-link indent-char "#343f44"
color-link scrollbar "#475258"
color-link trailingws "#e67e80"
